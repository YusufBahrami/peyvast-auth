#: src/Presentation/Admin/SettingsPage.php:410
msgid "Password reset"
msgstr "بازیابی رمز عبور"

#: src/Presentation/Admin/SettingsPage.php:410
msgid ""
"Password reset identifiers are configured independently from password sign-in."
msgstr "شناسه‌های بازنشانی رمز عبور مستقل از ورود با رمز عبور پیکربندی می‌شوند."

#: src/Presentation/Admin/SettingsPage.php:411
